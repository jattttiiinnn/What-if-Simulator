# Copy to .env to configure behaviour.

# Use the bundled sample dataset instead of the real API.
# Default is "true" so `npm run dev` works with no backend.
VITE_USE_MOCK=true

# Base URL of the real backend (used only when VITE_USE_MOCK=false).
# The bundled backend in ./backend runs here:
#   cd backend && uvicorn backend_main:app --port 8000
VITE_API_BASE=http://127.0.0.1:8000
